# ========================================
# Obsidian
# ========================================

# User-specific workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Bundled plugin code (downloadable, not source)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Obsidian trash
.trash/

# ========================================
# Security - NEVER commit these
# ========================================

# Certificates and keys
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# SSH keys
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub

# ========================================
# Database
# ========================================

*.sqlite
*.sqlite3
*.db
*.db-journal

# ========================================
# Backup & Archives
# ========================================

*.backup
*.bak
*.orig
*.zip
*.tar.gz
*.rar
*.7z

# ========================================
# Python (if any utility scripts)
# ========================================

__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
.venv/
.direnv/

# ========================================
# Project-specific
# ========================================

# Plugin marketplace - ignore custom extensions
plugins/*/agents/custom/
plugins/*/skills/custom/
plugins/*/commands/custom/
!plugins/*/agents/custom/.gitkeep
!plugins/*/skills/custom/.gitkeep
!plugins/*/commands/custom/.gitkeep

# Decap CMS dependencies (if using)
decap/node_modules/

# CLI package specific
packages/cli/dist/
packages/cli/node_modules/

# Keep these
!content/templates/examples/*.yaml
!content/schemas/*.json

out/

.secret
.repoprompt
.deepeval/

settings.local.json

# Generation artifacts (ephemeral, used by synapse generate)
.synapse-generate/
titles.json

# Local review/agent worktrees (e.g. .worktrees/pr49-<sha>); never part of the tree.
.worktrees/

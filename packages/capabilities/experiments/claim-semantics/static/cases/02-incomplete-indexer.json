  "schema_version": 1,
  "id": "02-incomplete-indexer",
  "title": "Incomplete indexer: a source file has no scip_document",
  "rule_pack": "rules-static-v1",
  "provenance": {
    "kind": "synthetic",
    "source": "hand-authored adversarial static case",
    "seeded_fault": null
